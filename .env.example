# Template de configuration — copier vers .env (déjà ignoré par git).
#   cp .env.example .env
#
# Les valeurs ci-dessous sont des défauts de DÉVELOPPEMENT LOCAL.
# /!\ NE PAS UTILISER TELLES QUELLES EN PRODUCTION /!\
# En prod : générer un mot de passe fort (`openssl rand -base64 32`) et le
# stocker dans un secret manager (Docker secrets, Vault, AWS SM…), pas dans
# un .env versionnable par erreur.

# --- Postgres (lu par l'image postgres:15 ET par app_api/modules/connect.py) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mydb
POSTGRES_PORT=5432
# Nom de service Docker Compose, PAS "localhost" : la résolution se fait via
# le réseau interne `api-db`. Si tu lances l'API hors Compose, remplace par
# "localhost" (ou l'IP de ton conteneur Postgres).
POSTGRES_HOST=db

# --- Frontend Streamlit (app_front) ---
# Nom de service Docker Compose pour atteindre l'API depuis le front. Idem
# remarque ci-dessus : "api" en Compose, "localhost" hors Compose.
API_HOST=api
